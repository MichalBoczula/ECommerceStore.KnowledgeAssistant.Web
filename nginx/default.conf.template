server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  client_max_body_size 32k;
  location = /health/live { access_log off; return 200 'healthy'; }
  location = /health/ready { access_log off; try_files /index.html =503; }
  location /api/ {
    proxy_pass ${KNOWLEDGE_API_URL};
    proxy_set_header X-API-Key "${KNOWLEDGE_API_KEY}";
    proxy_set_header Host $proxy_host;
    proxy_read_timeout 150s;
    proxy_connect_timeout 15s;
  }
  location / { try_files $uri $uri/ /index.html; }
}
