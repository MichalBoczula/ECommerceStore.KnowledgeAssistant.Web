            "title": "Service",
            "type": "string"
          },
          "snapshotId": {
            "title": "Snapshotid",
            "type": "string"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "title": "Sources",
            "type": "array"
          },
          "status": {
            "enum": [
              "answered",
              "partial",
              "not_found"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "requestId",
          "snapshotId",
          "service",
          "status",
          "answerMode",
          "retrievalMode",
          "isDemo",
          "sections",
          "sources",
          "limitations"
