          "sections": {
            "items": {
              "discriminator": {
                "mapping": {
                  "api_contract": "#/components/schemas/ContractSection",
                  "explanation": "#/components/schemas/ExplanationSection",
                  "scenario": "#/components/schemas/ScenarioSection",
                  "validation": "#/components/schemas/ValidationSection"
